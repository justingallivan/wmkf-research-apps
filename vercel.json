{
  "functions": {
    "pages/api/process.js": {
      "maxDuration": 300
    },
    "pages/api/process-*.js": {
      "maxDuration": 300
    },
    "pages/api/analyze-*.js": {
      "maxDuration": 300
    },
    "pages/api/cron/*.js": {
      "maxDuration": 120
    },
    "pages/api/cron/refresh-irs-bmf.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/health-check",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/secret-check",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/log-analysis",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/spend-check",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/reconcile-identities",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/refresh-irs-bmf",
      "schedule": "0 6 15 1,4,7,10 *"
    },
    {
      "path": "/api/cron/sweep-stale-invites",
      "schedule": "0 9 * * *"
    }
  ]
}
