<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>Wmkf.PromptPublication.Transport</AssemblyName>
    <RootNamespace>Wmkf.PromptPublication</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../registration/bindings.json" LogicalName="Wmkf.PromptPublication.ReleaseBindings.json"/>
    <EmbeddedResource Include="../../../lib/prompt-publication/policy-v1.json" LogicalName="Wmkf.PromptPublication.Policy.v1.json"/>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60"/>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.27"/>
  </ItemGroup>
</Project>
