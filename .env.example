# Environment Configuration
# Copy this file to .env.local and fill in values before running locally
# Note: .env.local is gitignored and will not be committed

# =============================================================================
# REQUIRED
# =============================================================================

# Claude API - Required for all AI features
CLAUDE_API_KEY=your_claude_api_key_here

# =============================================================================
# DATABASE (Vercel Postgres)
# =============================================================================

# Primary connection string - copy from Vercel dashboard
POSTGRES_URL=

# These are typically auto-set by Vercel when you link a Postgres database:
# POSTGRES_HOST, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DATABASE
# DATABASE_URL, DATABASE_URL_UNPOOLED

# =============================================================================
# AUTHENTICATION (Azure AD / Entra ID)
# =============================================================================

# NextAuth.js settings
NEXTAUTH_URL=http://localhost:3000
# Public base URL used in reviewer invitation magic links.
# Production today: https://wmkfresearch.vercel.app
# Future custom domain: https://reviews.wmkeck.org
REVIEWER_PORTAL_BASE_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Azure AD configuration - from Azure Portal app registration
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# =============================================================================
# OPTIONAL - Enhanced Features
# =============================================================================

# SERP API - For Google Scholar searches in Reviewer Finder
# Get key at: https://serpapi.com/
SERP_API_KEY=

# NCBI API - Higher rate limits for PubMed searches
# Get key at: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# ORCID API - For researcher identification
# Register at: https://orcid.org/developer-tools
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# =============================================================================
# OPTIONAL - Dynamics Explorer (CRM Queries)
# =============================================================================

# Microsoft Dynamics 365 - For natural-language CRM queries
# Requires an Azure AD app registration with Dynamics CRM API permissions
DYNAMICS_URL=https://wmkf.crm.dynamics.com
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=

# =============================================================================
# OPTIONAL - Storage & Security
# =============================================================================

# Vercel Blob Storage - For large file uploads (>4.5MB)
BLOB_READ_WRITE_TOKEN=

# User Preferences Encryption - 32-byte hex key for encrypting API keys in database
# Generate with: openssl rand -hex 32
USER_PREFS_ENCRYPTION_KEY=

# =============================================================================
# OPTIONAL - Cron Jobs & Monitoring
# =============================================================================

# Cron Secret - Required in production for Vercel Cron authentication
# Generate with: openssl rand -base64 32
# Set in Vercel dashboard; Vercel sends this as Authorization header for cron jobs
CRON_SECRET=

# Vercel API - For automated log analysis cron (optional)
# Get token at: https://vercel.com/account/tokens
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=

# =============================================================================
# OPTIONAL - External-party magic links (reviewer upload, etc.)
# =============================================================================

# HMAC secret for signing external-access JWTs (e.g., reviewer upload links).
# 32+ characters required. Kept distinct from NEXTAUTH_SECRET so the blast
# radius of a leak is bounded.
# Generate with: openssl rand -base64 32
# See lib/services/external-token.js and docs/EXTERNAL_REVIEWER_INTAKE_PLAN.md.
EXTERNAL_LINK_SECRET=

# =============================================================================
# OPTIONAL - Email Notifications (Future - requires Mail.Send permission)
# =============================================================================

# Microsoft Graph email - When configured, sends email for critical alerts
# See docs/TODO_EMAIL_NOTIFICATIONS.md for setup instructions
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
