# Environment Configuration
# Copy this file to .env.local and fill in values before running locally
# Note: .env.local is gitignored and will not be committed

# =============================================================================
# REQUIRED
# =============================================================================

# Claude API - Required for all AI features
CLAUDE_API_KEY=your_claude_api_key_here

# =============================================================================
# DATABASE (Vercel Postgres)
# =============================================================================

# Primary connection string - copy from Vercel dashboard
POSTGRES_URL=

# These are typically auto-set by Vercel when you link a Postgres database:
# POSTGRES_HOST, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DATABASE
# DATABASE_URL, DATABASE_URL_UNPOOLED

# =============================================================================
# AUTHENTICATION (Azure AD / Entra ID)
# =============================================================================

# NextAuth.js settings
NEXTAUTH_URL=http://localhost:3000
# Public base URL used in reviewer invitation magic links.
# Production today: https://wmkfresearch.vercel.app
# Future custom domain: https://reviews.wmkeck.org
REVIEWER_PORTAL_BASE_URL=http://localhost:3000
# Non-production reviewer invite rehearsal mode. Use "capture" to return the
# rendered email in the API response without sending through Dynamics.
REVIEWER_EMAIL_DELIVERY_MODE=send
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Azure AD configuration - from Azure Portal app registration
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# =============================================================================
# OPTIONAL - Enhanced Features
# =============================================================================

# SERP API - For Google Scholar searches in Reviewer Finder
# Get key at: https://serpapi.com/
SERP_API_KEY=

# NCBI API - Higher rate limits for PubMed searches
# Get key at: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# ORCID API - For researcher identification
# Register at: https://orcid.org/developer-tools
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# OpenAlex authenticated author/institution/work lookup.
# Get a key at: https://openalex.org/settings/api
OPENALEX_API_KEY=

# Optional non-secret ROR API client identifier. New registrations are
# temporarily paused; the resolver works without one and sends Client-Id when set.
ROR_CLIENT_ID=

# Reviewer identity runtime seams are independently server-owned. Unset, legacy,
# and unknown values are legacy-authoritative. Shadow observes without replacing
# results; combined requires a separate owner-approved gate for that entry point.
REVIEWER_IDENTITY_DISCOVERY_RESOLVER_MODE=legacy
REVIEWER_IDENTITY_WORKBENCH_RESOLVER_MODE=legacy
REVIEWER_IDENTITY_CONTACT_ENRICHMENT_RESOLVER_MODE=legacy

# =============================================================================
# OPTIONAL - Dynamics Explorer (CRM Queries)
# =============================================================================

# Microsoft Dynamics 365 - For natural-language CRM queries
# Requires an Azure AD app registration with Dynamics CRM API permissions
DYNAMICS_URL=https://wmkf.crm.dynamics.com
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=

# =============================================================================
# OPTIONAL - Storage & Security
# =============================================================================

# Vercel Blob Storage - For large file uploads (>4.5MB)
BLOB_READ_WRITE_TOKEN=

# User Preferences Encryption - 32-byte hex key for encrypting API keys in database
# Generate with: openssl rand -hex 32
USER_PREFS_ENCRYPTION_KEY=

# =============================================================================
# OPTIONAL - Cron Jobs & Monitoring
# =============================================================================

# Cron Secret - Required in production for Vercel Cron authentication
# Generate with: openssl rand -base64 32
# Set in Vercel dashboard; Vercel sends this as Authorization header for cron jobs
CRON_SECRET=

# Vercel API - For automated log analysis cron (optional)
# Get token at: https://vercel.com/account/tokens
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=

# =============================================================================
# OPTIONAL - External-party magic links (reviewer upload, etc.)
# =============================================================================

# HMAC secret for signing external-access JWTs (e.g., reviewer upload links).
# 32+ characters required. Kept distinct from NEXTAUTH_SECRET so the blast
# radius of a leak is bounded.
# Generate with: openssl rand -base64 32
# See lib/services/external-token.js and docs/EXTERNAL_REVIEWER_INTAKE_PLAN.md.
EXTERNAL_LINK_SECRET=

# =============================================================================
# OPTIONAL - Email Notifications
# =============================================================================

# Sender mailbox for system-alert email, sent over the Dynamics transport
# (the Microsoft Graph Mail.Send path was retired in S142).
# Must be a Dynamics systemuser resolvable by internalemailaddress with
# Server-Side Sync enabled - an alias or distribution group will not resolve.
# See docs/TODO_EMAIL_NOTIFICATIONS.md for setup instructions.
NOTIFICATION_EMAIL_FROM=
# Recipients are configured in /admin -> Alert Recipients
# (Dataverse setting: alertRecipientsByCategory).

# Monitored contact address sent to NCBI E-utilities and Europe PMC so they can
# reach a human about our API usage. Falls back to NOTIFICATION_EMAIL_FROM when
# unset; set it explicitly whenever NOTIFICATION_EMAIL_FROM is an unmonitored
# system mailbox. OpenAlex has its own OPENALEX_POLITE_MAILTO.
SCHOLARLY_POLITE_MAILTO=

# =============================================================================
# OPTIONAL - Reviewer Finder email recovery
# =============================================================================

# Enables the guarded faculty/profile-page email recovery tier.
# Default off; production was enabled 2026-07-03 after the S321/S322 rollout.
REVIEWER_PAGE_EMAIL_TIER_ENABLED=false

# =============================================================================
# OPTIONAL - Applicant intake drain tuning
# =============================================================================

# Defaults are DRAIN_BATCH_SIZE=5 and DRAIN_LOCK_TTL_SECONDS=600.
# Leave unset unless the intake drain needs operator tuning.
# DRAIN_BATCH_SIZE=
# DRAIN_LOCK_TTL_SECONDS=

# =============================================================================
# OPTIONAL - BILL.com honorarium integration
# =============================================================================

# Leave BILL_ENABLED=false until the BILL sandbox/production credentials,
# webhook secret, integration secret, and Dataverse option-set values are set.
BILL_ENABLED=false
# BILL_ONBOARDING_DEFERRED=true
# BILL_BASE_URL=
# BILL_USERNAME=
# BILL_PASSWORD=
# BILL_DEV_KEY=
# BILL_ORG_ID=
# BILL_WEBHOOK_SECRET=
# BILL_INTEGRATION_SECRET=
# BILL_WEBHOOK_DEBUG=false
# BILLCOM_ACCOUNT_YES_VALUE=
# BILLCOM_ACCOUNT_NO_VALUE=
