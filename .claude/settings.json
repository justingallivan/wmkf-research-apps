{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/scope-claim-reminder.js\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "scope-claim check"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/doc-edit-reconcile-reminder.js\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "doc-edit reconcile check"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/contract-surface-reminder.js\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "contract-surface check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/codex-verbatim-reminder.js\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "codex-verbatim check"
          }
        ]
      }
    ]
  }
}
