{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/protected-path-guard.js\"",
            "timeout": 10,
            "statusMessage": "protected-path check"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-scaffolding-tokens.js\"",
            "timeout": 10,
            "statusMessage": "scaffolding-token block"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/memory-router-guard.js\"",
            "timeout": 10,
            "statusMessage": "memory-router budget check"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/scope-claim-reminder.js\"",
            "timeout": 10,
            "statusMessage": "scope-claim check"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/docs-catalog-format-guard.js\"",
            "timeout": 10,
            "statusMessage": "docs-catalog format check"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/plan-named-source-read-guard.js\"",
            "timeout": 10,
            "statusMessage": "plan-source-read check"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/design-doc-assertion-guard.js\"",
            "timeout": 10,
            "statusMessage": "design-doc assertion check"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/claim-evidence-advisory.js\"",
            "timeout": 10,
            "statusMessage": "claim-evidence advisory"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/contract-surface-reminder.js\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "contract-surface check"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/agent-wiki-reminder.js\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "agent-wiki freshness check"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/enum-parity-commit-guard.js\"",
            "timeout": 30,
            "statusMessage": "status-enum-parity (commit guard)"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/trust-boundary-guid-commit-guard.js\"",
            "timeout": 30,
            "statusMessage": "trust-boundary-guid (commit guard)"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/docs-catalog-commit-guard.js\"",
            "timeout": 30,
            "statusMessage": "docs-catalog (commit guard)"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pre-commit-self-review.js\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "pre-commit self-review"
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pre-review-delegation-trace-guard.js\"",
            "timeout": 10,
            "statusMessage": "self-trace gate (pre-review)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-lifecycle.js\" record 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "record changed surface"
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-lifecycle.js\" review-record 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "record adversarial review receipt"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/codex-verbatim-reminder.js\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "codex-verbatim check"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-lifecycle.js\" start 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "capture session baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-lifecycle.js\" stop",
            "timeout": 130,
            "statusMessage": "verify session-owned surfaces"
          }
        ]
      }
    ]
  }
}
